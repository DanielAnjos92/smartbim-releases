                    Version="1.1.1"
                    ProductCode="{7C3E2A10-5B44-4E9A-9C21-A1B2C3D4E5F6}"
                    Name="SmartBIM Civil 3D"
                    Description="Ferramentas SmartBIM para Civil 3D"
                    Author="SmartBIM"
                    AppNameSpace="smartbim.civil3d">
  <CompanyDetails Name="SmartBIM" Email="SmartBIM@outlook.com.br" />

